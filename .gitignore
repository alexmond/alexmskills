# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.iml

# Claude Code local state (machine-specific, not for distribution)
.claude/settings.local.json
.claude/.session-locks.flock
.claude/session-locks.json

# Antora build output
doc/build/
public/
build/
node_modules/

# Python
__pycache__/
*.pyc
.claude/prompt-coach/

# Claude Code lock markers written into plugin dirs when they're symlinked
# for `make dev-link`. Not source; per-process ephemera.
plugins/*/.in_use/
beta/plugins/*/.in_use/

# prompt-coach eval drafts: auto-harvested prompt previews from ALL local
# repos (incl. private ones) — never publishable. golden.jsonl (curated,
# leak-checked) is the only committed eval data.
plugins/prompt-coach/eval/draft.jsonl
